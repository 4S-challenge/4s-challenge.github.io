					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- HTTPS(표준 암호화)만 쓰므로 App Store 수출 규정 질문이 매번 나오지 않게 한다. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- 앱 추적 투명성(ATT) 창 문구. 광고 SDK가 광고 식별자(IDFA)를 쓰기 전에 묻는다. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>나에게 더 맞는 광고를 보여주는 데 사용돼요. 허용하지 않아도 게임은 모두 그대로 이용할 수 있어요.</string>
	<!-- AdMob iOS 앱 ID (docs/STORE.md 3-1) -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3934873497580609~9320078431</string>
	<!-- 광고 성과 측정용 (Google 광고 네트워크) -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
	<!-- 링크 처리는 app_links 패키지가 한다. Flutter 기본 딥링크 처리는 끈다. -->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
</dict>
</plist>
